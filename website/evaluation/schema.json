{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "date": {
      "type": "string",
      "format": "timestamp"
    },
    "index_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sdk_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflow_url": {
      "type": "string",
      "format": "public-https-url"
    },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
            }
          },
          "expected": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "judge": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": ["programmatic", "llm"]
              },
              "model": {
                "type": ["string", "null"]
              },
              "scorer": {
                "type": ["string", "null"]
              },
              "official_model": {
                "type": ["string", "null"]
              },
              "prompt_revision": {
                "type": ["string", "null"]
              },
              "parity_note": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "model",
              "scorer",
              "official_model",
              "prompt_revision",
              "parity_note"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "llm"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scorer": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "scorer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "model": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "required": ["id", "revision", "domains", "expected", "name", "judge"]
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "harness": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "trajectory_url": {
            "type": "string",
            "format": "public-https-url"
          },
          "benchmarks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "benchmark": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "scored": {
                  "type": "integer",
                  "minimum": 0
                },
                "score": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "mean_runtime_seconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "mean_model_cost_usd": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cost_source": {
                  "enum": [
                    "reported",
                    "snapshot_estimated",
                    "litellm_estimated",
                    "unknown"
                  ]
                },
                "cost_basis": {
                  "enum": ["exact", "upper_bound", "unknown"]
                },
                "original_model_cost": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["currency", "mean_amount"],
                      "properties": {
                        "currency": {
                          "enum": ["CNY", "USD"]
                        },
                        "mean_amount": {
                          "type": "number",
                          "minimum": 0
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "mean_judge_cost_usd": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "original_judge_cost": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["currency", "mean_amount"],
                      "properties": {
                        "currency": {
                          "enum": ["CNY", "USD"]
                        },
                        "mean_amount": {
                          "type": "number",
                          "minimum": 0
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "benchmark",
                "scored",
                "score",
                "mean_runtime_seconds",
                "mean_model_cost_usd",
                "cost_source",
                "cost_basis",
                "original_model_cost",
                "mean_judge_cost_usd",
                "original_judge_cost"
              ]
            }
          }
        },
        "required": ["model", "provider", "harness", "benchmarks"]
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "group_by"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "group_by": {
          "enum": ["model", "model_harness"]
        }
      }
    },
    "kind": {
      "enum": ["testing", "official"]
    },
    "source_repository": {
      "type": "string",
      "format": "public-https-url"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "exchange_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cny_per_usd", "basis"],
      "properties": {
        "cny_per_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "basis": {
          "const": "fixed"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "date",
    "index_version",
    "sdk_version",
    "source_sha",
    "benchmarks",
    "records",
    "board",
    "kind",
    "source_repository",
    "artifact_sha256",
    "exchange_rate"
  ]
}
